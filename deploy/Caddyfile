# YouBike Caddy 設定（HTTPS 入口）：D1-b ＋ API-3
# 安裝到 /etc/caddy/Caddyfile（擁有者 root、權限 644）：
#   sudo install -m 644 -o root -g root deploy/Caddyfile /etc/caddy/Caddyfile
#   sudo caddy validate --config /etc/caddy/Caddyfile --adapter caddyfile
#
# - HTTPS 憑證由 Caddy 自動向 Let's Encrypt 申請與續期（HTTP-01 驗證，需要 80 port）。
#   不使用 DuckDNS 的 API，VM 上不需要 DuckDNS Token。
# - 不開 access log（查詢字串含使用者座標）；Caddy 本身的日誌寫到 journald（上限見 deploy/journald-youbike.conf）。
# - 管理介面維持預設 localhost:2019（只有本機可連），systemctl reload 需要它。
# - FastAPI 只綁定 127.0.0.1:8000（deploy/youbike-api.service），PostgreSQL 維持只用 Unix socket。
#
# API-3 路由：白名單、精確比對、預設拒絕。
# - Caddy 的 path 比對沒有萬用字元時就是完整路徑比對；這裡不使用 /stations* 這類萬用字元。
# - 只轉送下列「方法＋路徑」，其他一律 404（內容為空），包括 /ready、/docs、/redoc、/openapi.json、
#   /stations/（結尾斜線）、/stations/a/b，以及允許路徑上的其他 HTTP 方法。
#     GET  /health
#     GET  /stations
#     GET  /stations/nearby
#     GET  /stations/{station_id}   station_id 只允許英數字、底線、連字號，1～32 字
#     POST /line/webhook            body 上限 1 MB（應用程式另有同樣的上限）
# - /healthz 由 Caddy 直接回應（只代表 Caddy 與 HTTPS 正常）；/health 經 FastAPI（代表 API 程序正常）。
# - /ready（檢查資料庫）不對外，只在 VM 本機以 curl http://127.0.0.1:8000/ready 檢查。

youbike-data-mvp.duckdns.org {
	# 不回傳 Server 標頭（避免透露伺服器軟體）
	header -Server

	handle /healthz {
		respond "ok" 200
	}

	@api_get {
		method GET
		path /health /stations /stations/nearby
	}
	handle @api_get {
		reverse_proxy 127.0.0.1:8000
	}

	@api_station {
		method GET
		path_regexp ^/stations/[A-Za-z0-9_-]{1,32}$
	}
	handle @api_station {
		reverse_proxy 127.0.0.1:8000
	}

	@line_webhook {
		method POST
		path /line/webhook
	}
	handle @line_webhook {
		request_body {
			max_size 1MB
		}
		reverse_proxy 127.0.0.1:8000
	}

	# 其他所有方法與路徑：404，內容為空
	handle {
		respond 404
	}
}
